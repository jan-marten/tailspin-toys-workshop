---
import type { Category, Publisher } from '../types/game';

/** Props for the category/publisher filter form. */
interface Props {
    /** Categories offered as checkboxes. */
    categories: Category[];
    /** Publishers offered in the select. */
    publishers: Publisher[];
    /** Total number of games, shown in the result count. */
    total: number;
}

const { categories, publishers, total } = Astro.props;
---

<form
    role="search"
    aria-label="Filter games"
    class="mb-6 bg-slate-800/60 backdrop-blur-sm rounded-xl border border-slate-700/50 p-4 space-y-4"
    data-testid="filter-form"
>
    <fieldset class="min-w-0">
        <legend class="text-sm font-medium text-slate-200 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
                <label
                    class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900 px-3 py-1.5 text-sm text-slate-200 cursor-pointer hover:bg-slate-700 transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-900/40 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500"
                >
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-800 accent-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-wrap items-end gap-4">
        <div>
            <label for="filter-publisher" class="block text-sm font-medium text-slate-200 mb-2">Publisher</label>
            <select
                id="filter-publisher"
                name="publisher"
                class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>

        <button
            type="button"
            disabled
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-100 hover:bg-slate-700 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
            data-testid="filter-clear"
        >
            Clear filters
        </button>

        <p
            role="status"
            aria-live="polite"
            class="text-sm text-slate-300 ml-auto"
            data-testid="filter-result-count"
        >
            Showing {total} of {total} games
        </p>
    </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="filter-form"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

  if (form && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const checkboxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisher = form.querySelector<HTMLSelectElement>('select[name="publisher"]')!;
    const count = form.querySelector<HTMLElement>('[data-testid="filter-result-count"]')!;
    const empty = document.getElementById('filter-empty')!;
    const clear = form.querySelector<HTMLButtonElement>('[data-testid="filter-clear"]')!;

    /** Restores the form controls from the `category` and `publisher` URL query parameters. */
    const readUrl = (): void => {
      const params = new URLSearchParams(window.location.search);
      const selected = new Set(params.getAll('category'));
      checkboxes.forEach((box) => (box.checked = selected.has(box.value)));
      const pub = params.get('publisher') ?? '';
      publisher.value = Array.from(publisher.options).some((o) => o.value === pub) ? pub : '';
    };

    /** Shows only the cards matching the current selection and updates the count, empty state, and clear button. */
    const apply = (): void => {
      const selected = checkboxes.filter((box) => box.checked).map((box) => box.value);
      const pub = publisher.value;
      let visible = 0;
      for (const card of cards) {
        const match =
          (selected.length === 0 || selected.includes(card.dataset.categoryId ?? '')) &&
          (pub === '' || card.dataset.publisherId === pub);
        card.classList.toggle('hidden', !match);
        if (match) visible++;
      }
      grid.classList.toggle('hidden', visible === 0);
      empty.classList.toggle('hidden', visible !== 0);
      count.textContent = `Showing ${visible} of ${cards.length} games`;
      clear.disabled = selected.length === 0 && pub === '';
    };

    /** Writes the current selection to the URL query string without adding a history entry. */
    const syncUrl = (): void => {
      const params = new URLSearchParams();
      checkboxes.filter((box) => box.checked).forEach((box) => params.append('category', box.value));
      if (publisher.value) params.set('publisher', publisher.value);
      const query = params.toString();
      history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
    };

    /** Clears all filters, then re-applies and syncs the URL. */
    const reset = (): void => {
      checkboxes.forEach((box) => (box.checked = false));
      publisher.value = '';
      apply();
      syncUrl();
    };

    form.addEventListener('change', () => {
      apply();
      syncUrl();
    });
    form.addEventListener('submit', (event) => event.preventDefault());
    clear.addEventListener('click', reset);
    window.addEventListener('popstate', () => {
      readUrl();
      apply();
    });

    readUrl();
    apply();
  }
</script>
